table dHora

	column HoraProgramada
		dataType: int64
		formatString: 0
		isKey
		summarizeBy: none
		sourceColumn: HoraProgramada

	column HoraTexto
		dataType: string
		summarizeBy: none
		sourceColumn: HoraTexto

	column FranjaOrden
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: FranjaOrden

	column FranjaHoraria
		dataType: string
		summarizeBy: none
		sourceColumn: FranjaHoraria
		sortByColumn: FranjaOrden

	partition dHora = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaDatos & "dHora.parquet"))
				in
				    Origen

