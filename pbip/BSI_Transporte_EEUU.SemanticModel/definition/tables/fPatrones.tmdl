table fPatrones

	column MesKey
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: MesKey

	column AerolineaCod
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: AerolineaCod

	column DiaSemanaNum
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: DiaSemanaNum

	column HoraProgramada
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: HoraProgramada

	column Vuelos
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: Vuelos

	column Cancelados
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: Cancelados

	column Desviados
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: Desviados

	column LlegadasDemoradas
		dataType: int64
		isHidden
		summarizeBy: sum
		sourceColumn: LlegadasDemoradas

	partition fPatrones = m
		mode: import
		source =
				let
				    Origen = Parquet.Document(File.Contents(RutaDatos & "fPatrones.parquet"))
				in
				    Origen

