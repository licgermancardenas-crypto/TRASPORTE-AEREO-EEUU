model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-AR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["RutaDatos", "fVuelos", "dCalendario", "dAerolinea", "dOrigen", "dDestino", "dHora", "dCausaCancelacion"]

ref table fVuelos
ref table dCalendario
ref table dAerolinea
ref table dOrigen
ref table dDestino
ref table dHora
ref table dCausaCancelacion
